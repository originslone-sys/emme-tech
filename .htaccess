# ============================================================
# Hostinger / Apache — Front Controller + Proteção de arquivos
# ============================================================

Options -Indexes
RewriteEngine On

# ----------------------------------------------------------------
# Bloqueia acesso direto a pastas sensíveis (apenas se for diretório real)
# ----------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(app|bin|database|storage)(/|$) - [F,L]

# ----------------------------------------------------------------
# Bloqueia acesso a arquivos sensíveis
# ----------------------------------------------------------------
<FilesMatch "^\.env|\.env\.example|\.gitignore|\.git">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# ----------------------------------------------------------------
# Roteamento — tudo passa pelo index.php
# ----------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
