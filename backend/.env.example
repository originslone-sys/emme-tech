# RunPod
RUNPOD_API_KEY=sua_api_key_aqui
RUNPOD_ENHANCE_ENDPOINT=id_do_endpoint_de_upscaling
RUNPOD_WHISPER_ENDPOINT=id_do_endpoint_whisperx
RUNPOD_RENDER_ENDPOINT=id_do_endpoint_de_render_viral   # opcional: render na GPU (senão, render local)
RUNPOD_TTS_ENDPOINT=id_do_endpoint_de_narracao          # opcional: narração XTTS na GPU (senão, gTTS local)

# IA / APIs
DEEPSEEK_API_KEY=sua_api_key_deepseek
PEXELS_API_KEY=sua_api_key_pexels

# App
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000        # URL pública do backend (usada pelos workers RunPod)
STORAGE_PATH=/data
MUSIC_DIR=                                # opcional: diretório de músicas (padrão: assets/music)
