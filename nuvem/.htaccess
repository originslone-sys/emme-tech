RewriteEngine On

# Proteger arquivos sensiveis
RewriteRule ^config\.php$ - [F,L]
RewriteRule ^config\.example\.php$ - [F,L]
RewriteRule ^composer\.json$ - [F,L]
RewriteRule ^composer\.lock$ - [F,L]
RewriteRule ^vendor/ - [F,L]
RewriteRule ^src/ - [F,L]

# Redirecionar todas as requests de API para api.php
RewriteRule ^api/(.*)$ api.php?action=$1 [QSA,L]
