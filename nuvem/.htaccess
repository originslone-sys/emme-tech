RewriteEngine On

# Proteger arquivos sensiveis
RewriteRule ^config\.php$ - [F,L]
RewriteRule ^config\.example\.php$ - [F,L]
RewriteRule ^composer\.json$ - [F,L]
RewriteRule ^composer\.lock$ - [F,L]
RewriteRule ^vendor/ - [F,L]
RewriteRule ^src/ - [F,L]

# Redirecionar todas as requests de API para api.php
RewriteRule ^api/(.*)$ api.php?action=$1 [QSA,L]

# Aumentar limites de upload
php_value upload_max_filesize 500M
php_value post_max_size 500M
php_value max_execution_time 300
php_value max_input_time 300
