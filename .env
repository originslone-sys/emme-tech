# ============================================================
# SaaS WhatsApp AI Agent Manager — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME="WhatsApp AI Manager"
APP_URL=https://yourdomain.com
APP_ENV=production
# DEBUG: true em dev, false em produção
APP_DEBUG=false
# Chave mestra para criptografia AES-256-GCM (32 bytes em hex = 64 chars)
# Gere com: php -r "echo bin2hex(random_bytes(32));"
MASTER_KEY=your_64_char_hex_master_key_here

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=whatsapp_saas
DB_USER=whatsapp_user
DB_PASS=strong_database_password_here
DB_CHARSET=utf8mb4

# --- Session ---
SESSION_NAME=wams_sess
SESSION_LIFETIME=7200
# Domínio do cookie (deixe vazio para domínio atual)
SESSION_DOMAIN=

# --- WhatsApp Cloud API ---
# Verify token que você define no Meta Developer Console
WA_VERIFY_TOKEN=your_whatsapp_verify_token_here
# App Secret do seu App no Meta (para validar assinatura do webhook)
WA_APP_SECRET=your_meta_app_secret_here

# --- OpenRouter (padrão global, o cliente pode sobrescrever) ---
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Token padrão (opcional; cliente configura o dele no dashboard)
OPENROUTER_DEFAULT_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# URL de sucesso e cancelamento do checkout
STRIPE_SUCCESS_URL=https://yourdomain.com/app/billing?success=1
STRIPE_CANCEL_URL=https://yourdomain.com/app/billing?canceled=1

# --- Storage ---
STORAGE_PATH=/var/www/emme-tech/storage
UPLOAD_MAX_SIZE_MB=10
ALLOWED_EXTENSIONS=txt,md,pdf

# --- Cron / Jobs ---
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=60
# Timeout de lock de job em segundos (para evitar jobs travados)
JOB_LOCK_TIMEOUT=300

# --- Logs ---
LOG_LEVEL=info
# info | debug | warning | error
LOG_PATH=/var/www/emme-tech/storage/logs/app.log

# --- Admin padrão (usado apenas no create-admin.php) ---
ADMIN_DEFAULT_EMAIL=admin@yourdomain.com
ADMIN_DEFAULT_PASSWORD=ChangeMe123!

# --- Timezone ---
APP_TIMEZONE=America/Sao_Paulo
