# ╔══════════════════════════════════════════════════════════════╗
# ║          OKX TRADING BOT - CONFIGURAÇÃO DE API             ║
# ╠══════════════════════════════════════════════════════════════╣
# ║  Copie este arquivo para .env e preencha suas credenciais   ║
# ║  NUNCA faça commit do arquivo .env!                         ║
# ╚══════════════════════════════════════════════════════════════╝

# === Credenciais OKX API ===
OKX_API_KEY=sua_api_key_aqui
OKX_SECRET_KEY=sua_secret_key_aqui
OKX_PASSPHRASE=sua_passphrase_aqui

# === Modo de operação ===
# True = Testnet (simulação sem dinheiro real)
# False = Produção (dinheiro real - CUIDADO!)
OKX_DEMO_TRADING=True
