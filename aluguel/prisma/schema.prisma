generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum ContractStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum ChargeStatus {
  PENDING
  CONFIRMED
  OVERDUE
  REFUNDED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  phone         String?
  cpfCnpj       String?   @unique
  role          UserRole  @default(CLIENT)
  isActive      Boolean   @default(true)
  asaasCustomerId String? @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  properties    Property[]
  tenants       Tenant[]
  contracts     Contract[]
  charges       Charge[]
  wallet        Wallet?
  withdrawals   Withdrawal[]
  logs          Log[]

  @@map("users")
}

model Property {
  id            String         @id @default(cuid())
  userId        String
  name          String
  type          String         // Apartamento, Casa, Sala Comercial, etc.
  address       String
  number        String?
  complement    String?
  neighborhood  String
  city          String
  state         String
  zipCode       String
  rentValue     Float
  condoFee      Float?         @default(0)
  iptuValue     Float?         @default(0)
  status        PropertyStatus @default(AVAILABLE)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts     Contract[]

  @@map("properties")
}

model Tenant {
  id            String    @id @default(cuid())
  userId        String
  name          String
  email         String
  phone         String
  cpfCnpj       String
  birthDate     DateTime?
  address       String?
  profession    String?
  monthlyIncome Float?
  notes         String?
  asaasCustomerId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts     Contract[]

  @@map("tenants")
}

model Contract {
  id             String          @id @default(cuid())
  userId         String
  propertyId     String
  tenantId       String
  startDate      DateTime
  endDate        DateTime
  rentValue      Float
  dueDay         Int             // Dia do vencimento (1-28)
  deposit        Float?          @default(0)
  adjustmentIndex String?        @default("IGPM") // IGPM, IPCA, etc.
  status         ContractStatus  @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  property       Property        @relation(fields: [propertyId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  charges        Charge[]

  @@map("contracts")
}

model Charge {
  id              String       @id @default(cuid())
  userId          String
  contractId      String
  description     String
  value           Float
  netValue        Float        // Valor - taxa plataforma
  platformFee     Float        @default(20) // R$20 por aluguel recebido
  dueDate         DateTime
  paymentDate     DateTime?
  status          ChargeStatus @default(PENDING)
  asaasPaymentId  String?      @unique
  asaasBillingType String?     @default("BOLETO")
  invoiceUrl      String?
  bankSlipUrl     String?
  pixCode         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract        Contract     @relation(fields: [contractId], references: [id])

  @@map("charges")
}

model Wallet {
  id            String    @id @default(cuid())
  userId        String    @unique
  balance       Float     @default(0)
  totalReceived Float     @default(0)
  totalWithdrawn Float    @default(0)
  totalFees     Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  amount        Float
  bankName      String?
  bankAgency    String?
  bankAccount   String?
  pixKey        String?
  status        WithdrawalStatus @default(PENDING)
  processedAt   DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model SystemConfig {
  id            String    @id @default(cuid())
  key           String    @unique
  value         String
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("system_configs")
}

model Log {
  id            String    @id @default(cuid())
  userId        String?
  action        String
  entity        String
  entityId      String?
  details       String?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  user          User?     @relation(fields: [userId], references: [id])

  @@map("logs")
}
